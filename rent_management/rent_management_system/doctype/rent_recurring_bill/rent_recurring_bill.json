{
 "doctype": "DocType",
 "name": "Rent Recurring Bill",
 "module": "Rent Management System",
 "engine": "InnoDB",
 "field_order": [
  "title",
  "property",
  "vendor",
  "category",
  "amount",
  "frequency",
  "start_date",
  "next_due",
  "end_date",
  "active",
  "notes"
 ],
 "fields": [
  {
   "fieldname": "title",
   "label": "Title",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "property",
   "label": "Property",
   "fieldtype": "Link",
   "options": "Rent Property",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "vendor",
   "label": "Vendor",
   "fieldtype": "Link",
   "options": "Rent Vendor"
  },
  {
   "fieldname": "category",
   "label": "Category",
   "fieldtype": "Data",
   "default": "Other"
  },
  {
   "fieldname": "amount",
   "label": "Amount",
   "fieldtype": "Currency",
   "reqd": 1
  },
  {
   "fieldname": "frequency",
   "label": "Frequency",
   "fieldtype": "Select",
   "options": "Weekly\nMonthly\nQuarterly\nYearly",
   "default": "Monthly"
  },
  {
   "fieldname": "start_date",
   "label": "Start Date",
   "fieldtype": "Date",
   "reqd": 1
  },
  {
   "fieldname": "next_due",
   "label": "Next Due",
   "fieldtype": "Date",
   "read_only": 1
  },
  {
   "fieldname": "end_date",
   "label": "End Date",
   "fieldtype": "Date"
  },
  {
   "fieldname": "active",
   "label": "Active",
   "fieldtype": "Check",
   "default": "1"
  },
  {
   "fieldname": "notes",
   "label": "Notes",
   "fieldtype": "Small Text"
  }
 ],
 "track_changes": 1,
 "autoname": "hash",
 "permissions": [
  {
   "role": "Rent Manager",
   "read": 1
  },
  {
   "role": "System Manager",
   "read": 1
  }
 ]
}
